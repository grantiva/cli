+                self.checks.append({"phase": "ready-interrupt", "platform": platform, "exit": code, "runnerPID": runner_pid})
+            finally:
+                if proc.poll() is None:
+                    os.kill(proc.pid, signal.SIGINT)
+                    proc.wait(timeout=30)
+                self.stop_report_snapshot(snapshot)
