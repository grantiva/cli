+            if stop.get("status") != "stopped" or stop.get("pid") != runner_pid or self.session.exists():
+                raise AssertionError(stop)
+            self.assert_pid_gone(runner_pid)
+            self.assert_session_cleanup(runner_pid)
+            if platform == "android":
