+        return 2
+    phases = ns.phase or list(PHASES[:-1])
+    if ns.validate_only:
+        print(json.dumps({"valid": True, "phases": phases, "forceTeardownIsolated": True}, indent=2))
+        return 0
+    smoke: Smoke | None = None
+    status = "failed"
+    try:
+        smoke = Smoke(ns)
+        smoke.record_ownership()
+        for phase in phases:
+            getattr(smoke, phase.replace("-", "_"))()
