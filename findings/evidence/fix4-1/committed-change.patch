+func TestFailureCaptureDeadlineAbortsUnderlyingHTTP(t *testing.T) {
+	for _, name := range []string{"screenshot", "hierarchy"} {
+		t.Run(name, func(t *testing.T) {
+			release := make(chan struct{})
+			ack := make(chan bool, 1)
+			server := setupMockServer(t, map[string]func(http.ResponseWriter, *http.Request){
+				"GET /screenshot": func(w http.ResponseWriter, r *http.Request) {
+					select {
+					case <-r.Context().Done():
+						ack <- true
+					case <-release:
+						ack <- false
+					}
+				},
+				"GET /source": func(w http.ResponseWriter, r *http.Request) {
+					select {
+					case <-r.Context().Done():
+						ack <- true
+					case <-release:
+						ack <- false
+					}
+				},
+			})
+			defer server.Close()
+			// The safety release keeps the pre-fix RED run finite and joins the
+			// held handler even when the transport incorrectly ignores deadlines.
+			safety := time.AfterFunc(300*time.Millisecond, func() { close(release) })
+			defer safety.Stop()
+			d := New(newMockHTTPClient(server.URL).Client, screen1080(), &MockShellExecutor{})
+			ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+			defer cancel()
+			began := time.Now()
+			capture := d.FailureScreenshot
+			if name == "hierarchy" {
+				capture = d.FailureHierarchy
+			}
+			_, err := capture(ctx)
+			if !errors.Is(err, context.DeadlineExceeded) {
+				t.Errorf("capture ignored its deadline: %v", err)
+			}
+			if elapsed := time.Since(began); elapsed > 200*time.Millisecond {
+				t.Errorf("deadline took %s to abort HTTP", elapsed)
+			}
+			select {
+			case cancelled := <-ack:
+				if !cancelled {
