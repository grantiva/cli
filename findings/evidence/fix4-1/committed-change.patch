+func (d *blockingFailureArtifacts) capture(ctx context.Context, name string) ([]byte, error) {
+	d.active.Add(1)
+	defer d.active.Add(-1)
+	d.started <- name
+	if d.arrived.Add(1) == 3 {
+		close(d.ready)
+	}
+	select {
+	case <-d.ready:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	if name == d.blocked {
+		<-ctx.Done()
+		d.finished <- name
+		return nil, ctx.Err()
+	}
+	return []byte(name), nil
+}
+func (d *blockingFailureArtifacts) FailureScreenshot(ctx context.Context) ([]byte, error) {
+	return d.capture(ctx, "screenshot")
