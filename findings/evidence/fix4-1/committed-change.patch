+// The fatal arrives after the Displayed log snapshot, while the final PID
+// read still sees the crashed process. A PID is not a final crash verdict.
+type fatalAfterStatusShell struct {
+	inner *drawnThenCrashDevice
+	armed bool
+	crash bool
+	mu    sync.Mutex
+}
+
+func (s *fatalAfterStatusShell) Shell(cmd string) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out, err := s.inner.Shell(cmd)
+	if strings.Contains(out, "Displayed ") {
+		s.armed = true
+	}
+	if s.armed && s.crash && strings.Contains(cmd, "pidof") {
+		s.inner.mu.Lock()
+		s.inner.crashAt = time.Nanosecond
+		s.inner.mu.Unlock()
+	}
+	return out, err
+}
+
+func TestLaunchFinalFatalDecision(t *testing.T) {
+	for _, mode := range []string{"before-return", "healthy", "after-return"} {
+		t.Run(mode, func(t *testing.T) {
+			dev := &drawnThenCrashDevice{drawAt: time.Millisecond}
+			sh := &fatalAfterStatusShell{inner: dev, crash: mode == "before-return"}
+			client := &MockUIA2Client{launchAppFunc: func(string, map[string]interface{}) error { dev.launch(); return nil }}
+			d := fastLaunchDriver(client, sh)
+			r := d.Execute(&flow.LaunchAppStep{AppID: "com.example.app"})
+			if mode == "before-return" {
+				if r.Success || !isAppCrash(r) {
+					t.Fatalf("matching fatal before success: success=%v error=%v message=%s", r.Success, r.Error, r.Message)
+				}
+				return
+			}
+			if !r.Success {
+				t.Fatalf("launch before fatal failed: %v", r.Error)
+			}
+			if mode == "after-return" {
+				dev.mu.Lock()
+				dev.crashAt = time.Nanosecond
+				dev.mu.Unlock()
+				if err := d.crashNow(); !isAppCrashed(err) {
+					t.Fatalf("post-return crash was not watched: %v", err)
+				}
+				if !r.Success {
+					t.Fatal("post-return crash retroactively changed launch result")
+				}
+			}
+		})
+	}
+}
