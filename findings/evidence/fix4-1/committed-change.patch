+
+// FailureLogTail limits logcat to the launched app's PIDs, including a crashed
+// PID that no longer appears in pidof. Never return another application's logs.
+func (d *Driver) FailureLogTail(ctx context.Context) ([]byte, error) {
+	shell, ok := d.device.(interface {
+		ShellContext(context.Context, string) (string, error)
+	})
+	if !ok {
+		return nil, fmt.Errorf("log tail device does not support cancellation")
+	}
+	pids := append([]string(nil), d.watchPIDs...)
+	if len(pids) == 0 {
+		pids = append(pids, d.launchPIDs...)
+	}
+	if len(pids) == 0 && d.currentAppID != "" {
+		out, err := shell.ShellContext(ctx, "pidof "+shellQuote(d.currentAppID)+" || true")
+		if err != nil {
+			return nil, err
+		}
+		pids, _ = parsePIDs(out)
+	}
+	if len(pids) == 0 {
+		return nil, fmt.Errorf("no launched app PID available for log tail")
+	}
+	var output strings.Builder
+	for _, pid := range pids {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		command := "logcat -d -b main,system,crash --pid=" + shellQuote(pid) + " -t 200"
+		if d.currentAppSince != "" {
+			command = "logcat -d -b main,system,crash --pid=" + shellQuote(pid) + " -t " + shellQuote(d.currentAppSince)
+		}
+		out, err := shell.ShellContext(ctx, command)
+		if err != nil {
+			return nil, err
+		}
+		output.WriteString(out)
+		output.WriteByte('\n')
+	}
+	// Bound the saved tail even if the launch has produced many log lines.
+	lines := strings.Split(strings.TrimSuffix(output.String(), "\n"), "\n")
+	if len(lines) > 200 {
+		lines = lines[len(lines)-200:]
+	}
+	return []byte(strings.Join(lines, "\n")), nil
+}
