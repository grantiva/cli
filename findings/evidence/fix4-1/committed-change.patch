+		ScreenshotCtx(context.Context) ([]byte, error)
+	}); ok {
+		return c.ScreenshotCtx(uiautomator2.FailureCaptureContext(ctx))
+	}
+	return nil, fmt.Errorf("screenshot client does not support cancellation")
+}
+
+func (d *Driver) FailureHierarchy(ctx context.Context) ([]byte, error) {
