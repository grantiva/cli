+// failureArtifactCapturer is internal to the executor; each operation must
+// stop its underlying request/child and return when its context is cancelled.
+// Drivers without this contract retain synchronous capture.
+type failureArtifactCapturer interface {
+	FailureScreenshot(context.Context) ([]byte, error)
+	FailureHierarchy(context.Context) ([]byte, error)
+	FailureLogTail(context.Context) ([]byte, error)
+}
+
+func (fr *FlowRunner) captureFailureArtifacts(cmdIdx int, timing string, capturer failureArtifactCapturer, nested bool) report.CommandArtifacts {
+	parent := fr.ctx
+	if parent == nil {
+		parent = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(parent, 2*time.Second)
+	defer cancel()
+	type result struct {
+		name string
+		data []byte
+		err  error
+	}
+	done := make(chan result, 3)
+	for name, call := range map[string]func(context.Context) ([]byte, error){
+		"screenshot": capturer.FailureScreenshot, "hierarchy": capturer.FailureHierarchy, "logTail": capturer.FailureLogTail,
+	} {
+		go func() {
+			child, stop := context.WithTimeout(ctx, 1500*time.Millisecond)
+			defer stop()
+			started := time.Now()
+			logger.Debug("failure artifact %s started at %s", name, started.Format(time.RFC3339Nano))
+			data, err := call(child)
+			if child.Err() != nil {
+				err = child.Err()
+			}
+			logger.Debug("failure artifact %s finished at %s (%v): %v", name, time.Now().Format(time.RFC3339Nano), time.Since(started), err)
+			done <- result{name, data, err}
+		}()
+	}
+	artifacts := report.CommandArtifacts{}
+	// Drain every result, including cancellation acknowledgements. Never return
+	// leaving a collector running. The internal contract makes these waits bounded.
+	for range 3 {
+		r := <-done
+		if r.err == nil && len(r.data) > 0 {
+			var path string
+			switch r.name {
+			case "screenshot":
+				if nested {
+					path, r.err = fr.flowWriter.SaveNestedScreenshot(cmdIdx, r.data)
+				} else {
+					path, r.err = fr.flowWriter.SaveScreenshot(cmdIdx, timing, r.data)
+				}
+				if timing == "before" {
+					artifacts.ScreenshotBefore = path
+				} else {
+					artifacts.ScreenshotAfter = path
+				}
+			case "hierarchy":
+				if nested {
+					artifacts.ViewHierarchy, r.err = fr.flowWriter.SaveNestedHierarchy(cmdIdx, r.data)
+				} else {
+					artifacts.ViewHierarchy, r.err = fr.flowWriter.SaveViewHierarchy(cmdIdx, r.data)
+				}
+			case "logTail":
+				if nested {
+					artifacts.LogTail, r.err = fr.flowWriter.SaveNestedLogTail(cmdIdx, r.data)
+				} else {
+					artifacts.LogTail, r.err = fr.flowWriter.SaveLogTail(cmdIdx, r.data)
+				}
+			}
+		}
+		if r.err != nil {
+			if artifacts.Notes == nil {
+				artifacts.Notes = make(map[string]string)
+			}
+			artifacts.Notes[r.name] = r.err.Error()
+		}
+	}
+	return artifacts
+}
