+// FailureScreenshot uses the server socket, avoiding the slow adb screencap
+// and pull path. Per-request contexts are independent of concurrent hierarchy
+// capture and of the completed step's requestContexter state.
+func (d *Driver) FailureScreenshot(ctx context.Context) ([]byte, error) {
