+func TestFailureArtifactsConcurrentCancellation(t *testing.T) {
+	for _, blocked := range []string{"screenshot", "hierarchy", "logTail"} {
+		t.Run(blocked, func(t *testing.T) {
+			before := runtime.NumGoroutine()
+			began := time.Now()
+			for i := 0; i < 25; i++ {
+				d := &blockingFailureArtifacts{mockDriver: &mockDriver{}, blocked: blocked,
+					started: make(chan string, 3), finished: make(chan string, 1), ready: make(chan struct{})}
+				dir := t.TempDir()
+				fw := report.NewFlowWriter(&report.FlowDetail{ID: "capture"}, dir, nil)
+				fr := &FlowRunner{ctx: context.Background(), driver: d, flowWriter: fw}
+				start := time.Now()
+				artifacts := fr.captureArtifacts(0, "after", true)
+				if elapsed := time.Since(start); elapsed > 2250*time.Millisecond {
+					t.Fatalf("capture took %s", elapsed)
+				}
+				if len(d.started) != 3 {
+					t.Fatalf("started %d collectors, want 3", len(d.started))
+				}
+				select {
+				case name := <-d.finished:
+					if name != blocked {
+						t.Fatal(name)
+					}
+				default:
+					t.Fatal("blocked collector did not acknowledge cancellation")
+				}
+				if d.active.Load() != 0 {
+					t.Fatal("collector still running after capture")
+				}
+				data, err := json.Marshal(artifacts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var fields map[string]json.RawMessage
+				if err := json.Unmarshal(data, &fields); err != nil {
