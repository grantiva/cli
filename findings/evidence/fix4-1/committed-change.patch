+// ShellContext owns one adb child and waits for its exit, including after
+// cancellation. The serial is always carried into the child command.
+func (d *AndroidDevice) ShellContext(ctx context.Context, command string) (string, error) {
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	args := []string{}
+	if d.serial != "" {
+		args = append(args, "-s", d.serial)
+	}
+	args = append(args, "shell", command)
+	child := execCommand(d.adbPath, args...)
+	var stdout, stderr bytes.Buffer
+	child.Stdout, child.Stderr = &stdout, &stderr
+	// Bound pipe cleanup too, if the command starts a descendant with inherited IO.
+	child.WaitDelay = 100 * time.Millisecond
+	if err := child.Start(); err != nil {
+		return "", err
+	}
+	done := make(chan error, 1)
+	go func() { done <- child.Wait() }()
+	select {
+	case err := <-done:
+		if err != nil {
+			return stdout.String(), fmt.Errorf("adb shell: %w: %s", err, stderr.String())
+		}
+		return stdout.String(), nil
+	case <-ctx.Done():
+		_ = child.Process.Kill()
+		<-done
+		return stdout.String(), ctx.Err()
+	}
+}
