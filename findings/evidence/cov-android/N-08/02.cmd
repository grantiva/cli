D=$(cat $S/n08dir.txt); (for i in $(seq 1 60); do lsof +D "$D" 2>/dev/null | tail -n +2; sleep 2; done) > $S/n08-lsof.txt & L=$!; $GRANTIVA run --device emulator-5554 --no-build > $S/n08-run.out 2> $S/n08-run.err; echo "stock rc=$?"; grep -E "TOTAL|Screens:" $S/n08-run.err $S/n08-run.out | cut -c1-140; kill $L 2>/dev/null; echo "lsof hits under D: $(grep -c . $S/n08-lsof.txt)"; find "$D" -type f -exec stat -f "%m %N" {} + 2>/dev/null | sed "s|$D|\$D|g" | sort > $S/n08-after.txt; diff $S/n08-before.txt $S/n08-after.txt && echo "no file under D modified"
