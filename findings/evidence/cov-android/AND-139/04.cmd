for i in 1 2 3; do $GRANTIVA record --duration 2 --json --quiet --output $S/r139q.mp4 >/dev/null 2>$S/r139q-$i.err; echo "quiet $i: warn=$(grep -c Warning $S/r139q-$i.err) frames=$(ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of csv=p=0 $S/r139q.mp4)"; $GRANTIVA record --duration 2 --json --output $S/r139p.mp4 >/dev/null 2>$S/r139p-$i.err; echo "plain $i: warn=$(grep -c Warning $S/r139p-$i.err) frames=$(ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of csv=p=0 $S/r139p.mp4)"; done
