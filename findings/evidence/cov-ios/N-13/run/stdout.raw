{"id":1,"jsonrpc":"2.0","result":{"capabilities":{"resources":{"listChanged":false,"subscribe":true},"tools":{"listChanged":false}},"instructions":"Grantiva MCP server for iOS simulator and Android emulator automation. Use grantiva_* tools to interact with the device: tap, swipe, type, take screenshots, inspect the accessibility tree, build and run apps, manage simulators and emulators, and run visual regression tests.","protocolVersion":"2025-03-26","serverInfo":{"name":"grantiva","version":"2.1.0"}}}
{"id":2,"jsonrpc":"2.0","result":{"tools":[{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Take a screenshot of the device (iOS simulator or Android emulator). Returns a base64-encoded PNG image.","inputSchema":{"properties":{"format":{"description":"Output format: 'base64' (default) or 'file'","enum":["base64","file"],"type":"string"}},"type":"object"},"name":"grantiva_screenshot"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Tap on a UI element by accessibility label or by coordinates. After tapping, returns the updated accessibility tree so you can see what changed.","inputSchema":{"properties":{"label":{"description":"Accessibility label of the element to tap","type":"string"},"x":{"description":"X coordinate to tap, in the same unit as the hierarchy frames: points on iOS, dp on Android (used if label is not provided)","type":"number"},"y":{"description":"Y coordinate to tap, in the same unit as the hierarchy frames: points on iOS, dp on Android (used if label is not provided)","type":"number"}},"type":"object"},"name":"grantiva_tap"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Swipe on the device (iOS simulator or Android emulator) screen. After swiping, returns the updated accessibility tree.","inputSchema":{"properties":{"direction":{"description":"Swipe direction: up, down, left, right","enum":["up","down","left","right"],"type":"string"}},"required":["direction"],"type":"object"},"name":"grantiva_swipe"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Type text into the currently focused field on the device (iOS simulator or Android emulator). After typing, returns the updated accessibility tree.","inputSchema":{"properties":{"text":{"description":"Text to type","type":"string"}},"required":["text"],"type":"object"},"name":"grantiva_type"},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Get the current accessibility tree (view hierarchy) of the running app. Returns a JSON tree of all UI elements with their labels, types, frames, and states.","inputSchema":{"properties":{},"type":"object"},"name":"grantiva_a11y_tree"},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Run accessibility audit on the current screen. Checks for missing labels on interactive elements and tap targets smaller than 44pt (iOS) or 48dp (Android).","inputSchema":{"properties":{},"type":"object"},"name":"grantiva_a11y_check"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Build the project: xcodebuild on iOS, Gradle on Android. Returns build result with success status, duration, warnings, and errors.","inputSchema":{"properties":{"emulator":{"description":"AVD name to use, booting it if needed (Android; uses grantiva-android.yml)","type":"string"},"module":{"description":"Gradle module to assemble (Android; uses grantiva-android.yml, default app)","type":"string"},"scheme":{"description":"Xcode scheme to build (uses grantiva.yml if omitted)","type":"string"},"simulator":{"description":"Simulator name for destination (default: 'iPhone 16')","type":"string"},"variant":{"description":"Gradle build variant, e.g. debug or freeDebug (Android; default debug)","type":"string"}},"type":"object"},"name":"grantiva_build"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Build, install, and launch the app on the simulator or emulator.","inputSchema":{"properties":{"emulator":{"description":"AVD name to use, booting it if needed (Android; uses grantiva-android.yml)","type":"string"},"module":{"description":"Gradle module to assemble (Android; uses grantiva-android.yml, default app)","type":"string"},"scheme":{"description":"Xcode scheme to build (uses grantiva.yml if omitted)","type":"string"},"simulator":{"description":"Simulator name (default: 'iPhone 16')","type":"string"},"variant":{"description":"Gradle build variant, e.g. debug or freeDebug (Android; default debug)","type":"string"}},"type":"object"},"name":"grantiva_run"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Run the project's test suite using xcodebuild test (iOS only). Returns pass/fail counts and output.","inputSchema":{"properties":{"scheme":{"description":"Xcode scheme to test (uses grantiva.yml if omitted)","type":"string"},"simulator":{"description":"Simulator name for destination (default: 'iPhone 16')","type":"string"}},"type":"object"},"name":"grantiva_test"},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"List available iOS simulators with their name, UDID, state, runtime, and availability.","inputSchema":{"properties":{"filter":{"description":"Filter by state: 'booted', 'shutdown', or 'all' (default: 'all')","enum":["all","booted","shutdown"],"type":"string"}},"type":"object"},"name":"grantiva_sim_list"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Boot an iOS simulator by name or UDID. Returns the booted device info.","inputSchema":{"properties":{"name":{"description":"Simulator name or UDID to boot (default: 'iPhone 16')","type":"string"}},"type":"object"},"name":"grantiva_sim_boot"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Create or idempotently reuse an exact named simulator, optionally booting it to readiness. Only 'name' is required: an existing simulator with that name is reused as-is. To create one, the name must contain a device model (\"iPhone 17\") or 'device_type' must be given; the runtime defaults to the newest installed one.","inputSchema":{"properties":{"boot":{"type":"boolean"},"device_type":{"type":"string"},"name":{"type":"string"},"runtime":{"description":"Runtime name, version, identifier, or 'latest'","type":"string"}},"required":["name"],"type":"object"},"name":"grantiva_sim_ensure"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Explicitly delete one simulator by its exact name or UDID.","inputSchema":{"properties":{"name":{"type":"string"}},"required":["name"],"type":"object"},"name":"grantiva_sim_delete"},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"List Android Virtual Devices with the serial of each one that is running.","inputSchema":{"properties":{},"type":"object"},"name":"grantiva_emulator_list"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Boot an Android emulator by AVD name, or use it if it is already running. Defaults to emulator in grantiva-android.yml.","inputSchema":{"properties":{"name":{"description":"AVD name (default: emulator in grantiva-android.yml)","type":"string"}},"type":"object"},"name":"grantiva_emulator_boot"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Create an AVD when missing (installing its system image first) and optionally boot it. Only 'name' is required.","inputSchema":{"properties":{"boot":{"type":"boolean"},"name":{"type":"string"},"system_image":{"description":"System image package, e.g. system-images;android-35;google_apis;arm64-v8a","type":"string"}},"required":["name"],"type":"object"},"name":"grantiva_emulator_ensure"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Delete an AVD Grantiva created. Pass force to delete one it did not create. A running AVD is never deleted.","inputSchema":{"properties":{"force":{"type":"boolean"},"name":{"type":"string"}},"required":["name"],"type":"object"},"name":"grantiva_emulator_delete"},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Get current project context: config, the device the UI tools act on (the runner session's simulator or emulator; without a session, the configured one), Xcode or Android SDK, and runner session status.","inputSchema":{"properties":{},"type":"object"},"name":"grantiva_context"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Execute a batch of UI actions sequentially. Each step is an object with one action key. Supported actions: tap (by label), tap_xy (by coordinates), swipe (direction), type (text), wait (seconds). Every step is validated before any step runs: if a step is not an object or has no valid action, nothing runs and the result is an error naming each invalid step. Returns the final accessibility tree after all steps complete.","inputSchema":{"properties":{"steps":{"description":"Array of step objects. Each has one key: tap, tap_xy, swipe, type, or wait.","items":{"properties":{"swipe":{"description":"Swipe direction: up, down, left, right","type":"string"},"tap":{"description":"Accessibility label to tap","type":"string"},"tap_xy":{"description":"Coordinates to tap: {x, y}, in the same unit as the hierarchy frames (points on iOS, dp on Android)","properties":{"x":{"type":"number"},"y":{"type":"number"}},"type":"object"},"type":{"description":"Text to type into focused field","type":"string"},"wait":{"description":"Seconds to wait","type":"number"}},"type":"object"},"type":"array"}},"required":["steps"],"type":"object"},"name":"grantiva_script"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Capture screenshots for all configured screens. Equivalent to 'grantiva diff capture --no-build --json'. Assumes the app is already running on the device.","inputSchema":{"properties":{},"type":"object"},"name":"grantiva_vrt_capture"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Compare current captures against baselines. Equivalent to 'grantiva diff compare --json'. Returns diff results per screen with pixel and perceptual metrics.","inputSchema":{"properties":{},"type":"object"},"name":"grantiva_vrt_compare"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Promote current captures to baselines. Equivalent to 'grantiva diff approve [screens] --json'. Approves all screens if none specified.","inputSchema":{"properties":{"screens":{"description":"Screen names to approve. If omitted, approves all.","items":{"type":"string"},"type":"array"}},"type":"object"},"name":"grantiva_vrt_approve"}]}}
