uptime; t0=$(python3 -I -c 'import time;print(time.time())'); $GRANTIVA runner start --detach >/dev/null 2>&1; t1=$(python3 -I -c 'import time;print(time.time())'); n=0; until $GRANTIVA runner dump-hierarchy --format tree >/dev/null 2>&1; do n=$((n+1)); sleep 0.5; [ $n -gt 120 ] && break; done; t2=$(python3 -I -c 'import time;print(time.time())'); python3 -I -c "print('detach returned after %.1fs; first successful dump %.1fs after return (%d failed tries)'%($t1-$t0,$t2-$t1,$n))"; $GRANTIVA runner stop
