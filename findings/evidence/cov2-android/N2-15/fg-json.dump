                  [android.widget.TextView] label="Gmail" id="com.google.android.apps.nexuslauncher:id/icon" value="Gmail"
                [android.view.View] label="All apps" id="com.google.android.apps.nexuslauncher:id/apps_divider_view"
              [android.widget.FrameLayout] label="Search" id="com.google.android.apps.nexuslauncher:id/search_container_all_apps"
                [android.widget.RelativeLayout]
                  [android.widget.ImageView] label="Google app" id="com.google.android.apps.nexuslauncher:id/g_icon"
                  [android.widget.FrameLayout] id="com.google.android.apps.nexuslauncher:id/typeahead_input"
                    [android.widget.EditText] label="Search web and more" id="com.google.android.apps.nexuslauncher:id/input" value="Search web and more"
                  [android.widget.LinearLayout] id="com.google.android.apps.nexuslauncher:id/end_icons"
                    [android.widget.ImageView] label="Voice search" id="com.google.android.apps.nexuslauncher:id/mic_icon"
                    [android.widget.ImageButton] label="Google Lens" id="com.google.android.apps.nexuslauncher:id/lens_icon"
                  [android.widget.FrameLayout] id="com.google.android.apps.nexuslauncher:id/action_btn_container"
              [android.view.View] id="com.google.android.apps.nexuslauncher:id/fast_scroller"
            [android.view.View] label="Home"
            [android.widget.FrameLayout] id="com.google.android.apps.nexuslauncher:id/overview_actions_view"
