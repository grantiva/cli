[hierarchy]
  [android.widget.FrameLayout]
    [android.widget.FrameLayout] id="com.android.systemui:id/status_bar_launch_animation_container"
    [android.widget.FrameLayout] id="com.android.systemui:id/status_bar_container"
      [android.widget.FrameLayout] id="com.android.systemui:id/status_bar"
        [android.widget.LinearLayout] id="com.android.systemui:id/status_bar_contents"
          [android.widget.FrameLayout] id="com.android.systemui:id/status_bar_start_side_container"
            [android.widget.FrameLayout] id="com.android.systemui:id/status_bar_start_side_content"
              [android.widget.LinearLayout] id="com.android.systemui:id/status_bar_start_side_except_heads_up"
                [android.widget.TextView] label="12:01 PM" id="com.android.systemui:id/clock" value="12:01"
                [android.widget.FrameLayout] id="com.android.systemui:id/notification_icon_area"
                  [android.view.ViewGroup] id="com.android.systemui:id/notificationIcons"
                    [android.widget.ImageView] label="Android System notification: Serial console enabled"
          [android.view.View] id="com.android.systemui:id/cutout_space_view"
          [android.widget.FrameLayout] id="com.android.systemui:id/status_bar_end_side_container"
            [android.widget.LinearLayout] id="com.android.systemui:id/status_bar_end_side_content"
              [android.widget.LinearLayout] id="com.android.systemui:id/system_icons"
                [android.widget.LinearLayout] id="com.android.systemui:id/statusIcons"
                  [android.widget.FrameLayout] id="com.android.systemui:id/wifi_combo"
                    [android.widget.LinearLayout] id="com.android.systemui:id/wifi_group"
                      [android.widget.FrameLayout] id="com.android.systemui:id/wifi_combo"
                        [android.widget.ImageView] label="Wifi signal full." id="com.android.systemui:id/wifi_signal"
                  [android.widget.FrameLayout] label="Phone signal full." id="com.android.systemui:id/mobile_combo"
                    [android.widget.LinearLayout] id="com.android.systemui:id/mobile_group"
                      [android.widget.FrameLayout]
                        [android.widget.ImageView] id="com.android.systemui:id/mobile_signal"
                [android.widget.LinearLayout] label="Battery 100 percent." id="com.android.systemui:id/battery"
                  [android.widget.ImageView]
  [android.widget.FrameLayout]
    [android.widget.LinearLayout]
      [android.widget.FrameLayout] id="android:id/content"
        [android.widget.FrameLayout] id="com.google.android.apps.nexuslauncher:id/launcher"
          [android.widget.FrameLayout] id="com.google.android.apps.nexuslauncher:id/drag_layer"
            [android.view.View] id="com.google.android.apps.nexuslauncher:id/scrim_view"
            [android.widget.RelativeLayout] id="com.google.android.apps.nexuslauncher:id/apps_view"
              [android.widget.GridView] id="com.google.android.apps.nexuslauncher:id/apps_list_view"
                [android.widget.TextView] label="Calendar" id="com.google.android.apps.nexuslauncher:id/icon" value="Calendar"
                [android.widget.TextView] label="Camera" id="com.google.android.apps.nexuslauncher:id/icon" value="Camera"
                [android.widget.TextView] label="Chrome" id="com.google.android.apps.nexuslauncher:id/icon" value="Chrome"
                [android.widget.TextView] label="Clock" id="com.google.android.apps.nexuslauncher:id/icon" value="Clock"
                [android.widget.TextView] label="Contacts" id="com.google.android.apps.nexuslauncher:id/icon" value="Contacts"
                [android.widget.TextView] label="Drive" id="com.google.android.apps.nexuslauncher:id/icon" value="Drive"
                [android.widget.TextView] label="Files" id="com.google.android.apps.nexuslauncher:id/icon" value="Files"
                [android.widget.TextView] label="Gmail" id="com.google.android.apps.nexuslauncher:id/icon" value="Gmail"
                [android.widget.TextView] label="Google" id="com.google.android.apps.nexuslauncher:id/icon" value="Google"
                [android.widget.TextView] label="Landmarks" id="com.google.android.apps.nexuslauncher:id/icon" value="Landmarks"
                [android.widget.TextView] label="Maps" id="com.google.android.apps.nexuslauncher:id/icon" value="Maps"
                [android.widget.TextView] label="Messages" id="com.google.android.apps.nexuslauncher:id/icon" value="Messages"
                [android.widget.TextView] label="Phone" id="com.google.android.apps.nexuslauncher:id/icon" value="Phone"
                [android.widget.TextView] label="Photos" id="com.google.android.apps.nexuslauncher:id/icon" value="Photos"
                [android.widget.TextView] label="Safety" id="com.google.android.apps.nexuslauncher:id/icon" value="Safety"
                [android.widget.TextView] label="Settings" id="com.google.android.apps.nexuslauncher:id/icon" value="Settings"
                [android.widget.TextView] label="TMoble" id="com.google.android.apps.nexuslauncher:id/icon" value="TMoble"
                [android.widget.TextView] label="YouTube" id="com.google.android.apps.nexuslauncher:id/icon" value="YouTube"
                [android.widget.TextView] label="YT Music" id="com.google.android.apps.nexuslauncher:id/icon" value="YT Music"
              [android.widget.LinearLayout] id="com.google.android.apps.nexuslauncher:id/all_apps_header"
                [android.widget.LinearLayout] id="com.google.android.apps.nexuslauncher:id/prediction_row"
                  [android.widget.TextView] label="YouTube" id="com.google.android.apps.nexuslauncher:id/icon" value="YouTube"
                  [android.widget.TextView] label="Clock" id="com.google.android.apps.nexuslauncher:id/icon" value="Clock"
