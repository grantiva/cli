pkg/driver/uiautomator2/swipe_geometry_test.go:17:		{"pixels", "900, 520", "100, 520", "input swipe 900 520 100 520 300"},
pkg/driver/uiautomator2/swipe_geometry_test.go:18:		{"pixels without spaces", "900,520", "100,520", "input swipe 900 520 100 520 300"},
pkg/driver/wda/swipe_geometry_test.go:72:	if result := driver.swipe(&flow.SwipeStep{Start: "900, 520", End: "100, 520"}); result.Success {
pkg/flow/swipe_coords_test.go:11:		{"plain pixels", "- swipe:\n    start: 900, 520\n    end: 100, 520\n", "900, 520", "100, 520"},
func TestSwipeFromNearEdgeElementStartsOnFarSide(t *testing.T) {
	shell := &MockShellExecutor{}
	client := &MockUIA2Client{
		findElementFunc: func(_, _ string) (*uiautomator2.Element, error) {
			return uiautomator2.NewCachedElement("tahoe", "Lake Tahoe", uiautomator2.ElementRect{X: 42, Y: 469, Width: 227, Height: 63}), nil
		},
	}
	d := New(client, screen1080(), shell)
	r := d.swipe(&flow.SwipeStep{Direction: "LEFT", Selector: &flow.Selector{Text: "Lake Tahoe"}, BaseStep: flow.BaseStep{TimeoutMs: 1000}})
	if !r.Success {
		t.Fatalf("swipe failed: %s", r.Message)
	}
	if len(shell.commands) != 1 || shell.commands[0] != "input swipe 246 500 0 500 300" {
		t.Errorf("commands = %q, want [input swipe 246 500 0 500 300]", shell.commands)
	}
}

// K06 fix round 2: a screenshot that fails because the server is gone names
// the UIAutomator2 server once in the step line, not again as the cause.
func TestScreenshotFailureNamesServerOnce(t *testing.T) {
	down := &uiautomator2.ServerUnavailableError{
		Device: "emulator-5556", Reason: "connection refused", Retries: 5, Replayable: true,
		Err: errors.New("dial unix /tmp/uia2-emulator-5556.sock: connect: connection refused"),
	}
	for _, step := range []flow.Step{&flow.TakeScreenshotStep{Path: "x"}, &flow.WaitForAnimationToEndStep{}} {
		d := New(&MockUIA2Client{screenshotErr: down}, screen1080(), nil)
		r := d.Execute(step)
		if r.Success {
			t.Fatalf("%T: want failure", step)
		}
		line := renderedFailure(r)
		if n := strings.Count(line, "UIAutomator2 server on emulator-5556 stopped responding"); n != 1 {
			t.Errorf("%T: server named %d times: %s", step, n, line)
		}
		if strings.Contains(line, "(cause:") {
			t.Errorf("%T: cause repeated: %s", step, line)
